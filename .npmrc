node-options=--max_old_space_size=6144
# Resolve only package versions published at least 7 days ago, so a new install or lockfile
# refresh cannot pick up a brand-new release. npm ci still installs the lockfile as is.
# When the window blocks an urgent security fix (an ETARGET error, or npm audit fix exits
# non-zero), bypass it for one command:
#   npm install <package>@<version> --min-release-age=0
min-release-age=7
